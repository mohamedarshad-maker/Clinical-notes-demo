# Application Environment
APP_ENV=development
DEMO_ONLY=true
APP_SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/clinical_notes

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=clinical-notes-private

# LLM Provider (choose one)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# GEMINI_API_KEY=your-gemini-api-key
# OR
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-70b-versatile
GROQ_API_KEY=your-groq-api-key

# LLM Concurrency
LLM_MAX_CONCURRENT_REQUESTS=3
MAX_ACTIVE_PATIENT_ANALYSES=1

# WHO ICD-11 MMS (REQUIRED)
WHO_ICD_CLIENT_ID=your-client-id-from-who-registration
WHO_ICD_CLIENT_SECRET=your-client-secret-from-who-registration
WHO_ICD_RELEASE=2026-01
WHO_ICD_LANGUAGE=en

# Upload Limits
MAX_FILES_PER_UPLOAD=5
MAX_FILE_MB=10
MAX_BATCH_MB=25
MAX_PDF_PAGES=20
MAX_IMAGE_MEGAPIXELS=25

# OCR Configuration
OCR_LANGUAGE=eng
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe  # Windows path if needed

# Demo Access (for deployed environments)
DEMO_USERNAME=demo
DEMO_PASSWORD=change-this-password
